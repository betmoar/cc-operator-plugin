# ops-corpus.sh build map — one line per file the derived tree gets:
#   <dir-under-the-corpus> <source-file> <production-name>
#
# The DRIFTED column only. `true/` is the false-positive control and is built
# separately (point --corpus at a copy whose map lists true/ instead), never
# side by side: a lens shown both columns at once is comparing them, not
# detecting drift in one.
#
# Note the first field carries the `drifted/` segment — the map addresses a
# path under the corpus, not a fixture name, which is what lets a drift fixture
# contribute SEVERAL files (stdout-copies is one claim living in three) while a
# security fixture contributes one.
errno-claim/drifted check.mjs ops-precondition.mjs
lock-ceiling/drifted lock.sh ops-lock.sh
stdout-copies/drifted ops-verdict.sh ops-ledger-write.sh
stdout-copies/drifted ops-adopt.sh ops-reclaim.sh
stdout-copies/drifted CHANGELOG-fragment.md CHANGELOG.md
tier-split-meta/drifted review.mjs panel.mjs
agenttype-anchor/drifted dispatch.mjs seat-dispatch.mjs
doc-regex-table/drifted ops-tiers.sh ops-resolve-tiers.sh
